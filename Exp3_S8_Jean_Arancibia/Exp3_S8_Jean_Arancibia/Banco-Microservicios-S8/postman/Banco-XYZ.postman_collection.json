  "item": [
    {
      "name": "01 - Infraestructura",
      "item": [
        {
          "name": "Config protegido",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{config_url}}/cuentas-service/default",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Configuración de API",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{config_url}}/cuentas-service/default",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{cloud_user}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{cloud_password}}",
                  "type": "string"
                }
