  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "auth_url",
      "value": "http://localhost:9000",
      "type": "string"
    },
    {
      "key": "config_url",
      "value": "http://localhost:8888",
      "type": "string"
    },
    {
      "key": "discovery_url",
      "value": "http://localhost:8761",
      "type": "string"
    },
    {
      "key": "cloud_user",
      "value": "cloud",
      "type": "string"
    },
    {
      "key": "cloud_password",
      "value": "CloudLocal2026!",
      "type": "string"
    },
    {
      "key": "admin_secret",
      "value": "AdminClientLocal2026!",
