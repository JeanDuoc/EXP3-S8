    {
      "name": "04 - Reporte asíncrono JMS",
      "item": [
        {
          "name": "Solicitar reporte - 202",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base_url}}/api/reportes/solicitudes"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 202\", () => pm.response.to.have.status(202));",
                  "if (pm.response.code === 202) pm.collectionVariables.set(\"reporte_id\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar reporte (espera 3 segundos)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/reportes/solicitudes/{{reporte_id}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "await new Promise(resolve => setTimeout(resolve, 3000));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
